  {"dbfId": 67804, "id": "AV_113t1", "name": "强化爆炸陷阱", "text": "<b>奥秘：</b>当你的英雄受到攻击，对所有敌人造成$3点伤害。", "type": "SPELL", "cardClass": "HUNTER", "set": "ALTERAC_VALLEY", "mechanics": ["SECRET"]},
  {"dbfId": 67805, "id": "AV_113t2", "name": "强化冰冻陷阱", "text": "<b>奥秘：</b>当一个敌方随从攻击时，将其移回拥有者的手牌，并且法力值消耗增加（4）点。", "type": "SPELL", "cardClass": "HUNTER", "set": "ALTERAC_VALLEY", "mechanics": ["SECRET"]},
  {"dbfId": 67808, "id": "AV_113t3", "name": "强化毒蛇陷阱", "text": "<b>奥秘：</b>当你的随从受到攻击时，召唤三条2/2的蛇。", "type": "SPELL", "cardClass": "HUNTER", "set": "ALTERAC_VALLEY", "mechanics": ["SECRET"]},
  {"dbfId": 70207, "id": "AV_113t7", "name": "强化集群战术", "text": "<b>奥秘：</b>当一个友方随从受到攻击时，召唤两个该随从的3/3的复制。", "type": "SPELL", "cardClass": "HUNTER", "set": "ALTERAC_VALLEY", "mechanics": ["SECRET"]},
  {"dbfId": 70208, "id": "AV_113t8", "name": "强化打开兽笼", "text": "<b>奥秘：</b>当你的回合开始时，如果你控制着两个随从，召唤两个动物伙伴。", "type": "SPELL", "cardClass": "HUNTER", "set": "ALTERAC_VALLEY", "mechanics": ["SECRET"]},
  {"dbfId": 71468, "id": "AV_113t9", "name": "强化冰霜陷阱", "text": "<b>奥秘：</b>当你的对手施放一个法术时，改为将其移回拥有者的手牌，并且法力值消耗增加（2）点。", "type": "SPELL", "cardClass": "HUNTER", "set": "ALTERAC_VALLEY", "mechanics": ["SECRET"]},
  {"dbfId": 79785, "id": "MAW_010t", "name": "强化否决动议", "text": "<b>奥秘：</b>当你的对手在一回合中使用三张牌后，对敌方英雄造成$9点伤害。", "type": "SPELL", "cardClass": "HUNTER", "set": "REVENDRETH", "mechanics": ["SECRET"]},
  {"dbfId": 87910, "id": "NX2_013t2", "name": "强化僵尸蜂群", "text": "<b>奥秘：</b>在你的对手使用一张随从牌后，召唤四只2/2的尸蜂攻击它。", "type": "SPELL", "cardClass": "HUNTER", "set": "RETURN_OF_THE_LICH_KING", "mechanics": ["SECRET"]},
  {"dbfId": 77245, "id": "TSC_929t", "name": "强化紧急机动", "text": "<b>奥秘：</b>当一个友方随从死亡时，召唤两个它的复制。复制会<b>休眠</b>1回合。", "type": "SPELL", "cardClass": "HUNTER", "set": "THE_SUNKEN_CITY", "mechanics": ["SECRET"]}
]
